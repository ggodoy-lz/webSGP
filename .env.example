# Variables de entorno del sitio SGP.
# Copiar como .env.local para desarrollo; en producción se cargan desde Vercel.

# Contraseña de los paneles de administración. OBLIGATORIA: si no está
# definida, los paneles responden 503 y no deja entrar a nadie. Antes había una
# por defecto en el código, pero el repositorio es público y por lo tanto esa
# contraseña era de conocimiento general.
ADMIN_PASSWORD=

# Almacenamiento de las noticias que se cargan desde /admin/noticias.
# Vercel la inyecta sola al crear un store de Blob en el proyecto; no hace falta
# copiarla a mano. Sin esta variable el panel guarda en data/noticias.json, que
# solo sirve en desarrollo: el filesystem de Vercel es de solo lectura y se
# descarta en cada deploy.
BLOB_READ_WRITE_TOKEN=

# Envío de los formularios (contacto, ISRC y presupuesto), vía Resend.
# Sin esta clave los formularios responden con error y le piden a la persona que
# escriba directo por correo: es preferible a decirle "enviado" y que no llegue
# nada.
RESEND_API_KEY=

# A dónde llegan los avisos de los formularios. Por defecto sgp@sgp.com.py.
EMAIL_DESTINO=

# Remitente de los avisos. El dominio tiene que estar verificado en Resend, si
# no rechaza el envío. Por defecto "SGP Web <web@sgp.com.py>".
EMAIL_REMITENTE=

# Dirección pública del sitio, sin barra final. La usan el sitemap, el
# robots.txt y las etiquetas para compartir en redes. Si no se define se toma la
# URL que Vercel asigna al despliegue; conviene fijar el dominio definitivo.
NEXT_PUBLIC_SITIO=
