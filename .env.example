# Variables de entorno del sitio SGP.
# Copiar como .env.local para desarrollo; en producción se cargan desde Vercel.

# Contraseña de los paneles de administración (/admin/noticias y /admin/tarifario).
# Si no se define, queda una por defecto en el código: conviene definirla siempre
# en producción.
ADMIN_PASSWORD=

# Almacenamiento de las noticias que se cargan desde /admin/noticias.
# Vercel la inyecta sola al crear un store de Blob en el proyecto; no hace falta
# copiarla a mano. Sin esta variable el panel guarda en data/noticias.json, que
# solo sirve en desarrollo: el filesystem de Vercel es de solo lectura y se
# descarta en cada deploy.
BLOB_READ_WRITE_TOKEN=
